#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	@echo "Engine and extension are prepared by scripts/build-deb.sh"

override_dh_auto_install:
	mkdir -p debian/kixkan-browser
	cp -a build/package-root/. debian/kixkan-browser/

override_dh_shlibdeps:
	dh_shlibdeps --dpkg-shlibdeps-params=--ignore-missing-info

